  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=1920, height=1080\">\n<title>PCB Lead Times Hit 140 Days</title>\n</head>\n<body style=\"margin:0;padding:0;width:1920px;height:1080px;background:#0d0d0d;font-family:'Segoe UI',Helvetica,Arial,sans-serif;color:#ffffff;overflow:hidden;position:relative;text-align:center;\">\n\n<!-- Subtle grid background -->\n<div style=\"position:absolute;top:0;left:0;width:100%;height:100%;background-image:linear-gradient(rgba(255,102,0,0.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,102,0,0.06) 1px,transparent 1px);background-size:60px 60px;z-index:0;\"></div>\n\n<!-- Top accent bar -->\n<div style=\"position:absolute;top:0;left:0;width:100%;height:4px;background:linear-gradient(90deg,#ff6600,#ff8833,#ff6600);z-index:2;\"></div>\n\n<!-- Main container -->\n<div style=\"position:relative;z-index:1;width:1920px;height:1080px;box-sizing:border-box;padding:44px 64px 36px 64px;display:flex;flex-direction:column;text-align:center;\">\n\n  <!-- Header -->\n  <div style=\"text-align:center;margin-bottom:24px;\">\n    <div style=\"font-size:13px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#ff6600;margin-bottom:8px;text-align:center;\">Supply Chain Alert</div>\n    <h1 style=\"margin:0;font-size:40px;font-weight:800;line-height:1.15;color:#ffffff;text-align:center;\">PCB Lead Times Hit <span style=\"color:#ff6600;\">140 Days</span></h1>\n    <div style=\"font-size:14px;color:#666;margin-top:6px;text-align:center;\">Q1 2026 | Source: ILFA GmbH</div>\n  </div>\n\n  <!-- Divider -->\n  <div style=\"width:80px;height:3px;background:#ff6600;margin:0 auto 28px auto;text-align:center;\"></div>\n\n  <!-- Three column stats row -->\n  <div style=\"display:flex;gap:40px;margin-bottom:28px;text-align:center;\">\n\n    <!-- FR-4 Lead Time -->\n    <div style=\"flex:1;border-left:3px solid #ff6600;padding:20px;text-align:center;\">\n      <div style=\"font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#666;margin-bottom:8px;text-align:center;\">Standard FR-4</div>\n      <svg width=\"200\" height=\"80\" viewBox=\"0 0 200 80\" xmlns=\"http://www.w3.org/2000/svg\" style=\"display:block;margin:0 auto;\">\n        <rect x=\"10\" y=\"8\" width=\"36\" height=\"28\" rx=\"2\" fill=\"#555\"/>\n        <text x=\"28\" y=\"27\" text-anchor=\"middle\" font-family=\"Segoe UI,Helvetica,Arial,sans-serif\" font-size=\"13\" fill=\"#fff\" font-weight=\"700\">5d</text>\n        <text x=\"56\" y=\"27\" font-family=\"Segoe UI,Helvetica,Arial,sans-serif\" font-size=\"10\" fill=\"#666\">was</text>\n        <rect x=\"10\" y=\"44\" width=\"130\" height=\"28\" rx=\"2\" fill=\"#ff6600\"/>\n        <text x=\"75\" y=\"63\" text-anchor=\"middle\" font-family=\"Segoe UI,Helvetica,Arial,sans-serif\" font-size=\"13\" fill=\"#fff\" font-weight=\"700\">18 days</text>\n        <text x=\"150\" y=\"63\" font-family=\"Segoe UI,Helvetica,Arial,sans-serif\" font-size=\"10\" fill=\"#ff6600\">now</text>\n      </svg>\n      <div style=\"font-size:28px;font-weight:900;color:#ff6600;text-align:center;\">+260%</div>\n    </div>\n\n    <!-- High-Tg -->\n    <div style=\"flex:1;border-left:3px solid #ff3300;padding:20px;text-align:center;\">\n      <div style=\"font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#ff4444;margin-bottom:8px;text-align:center;\">High-Tg Laminates</div>\n      <div style=\"font-size:72px;font-weight:900;color:#ff6600;line-height:1;text-align:center;\">140</div>\n      <div style=\"font-size:14px;color:#999;font-weight:600;text-align:center;\">DAYS LEAD TIME</div>\n    </div>\n\n    <!-- AI Demand -->\n    <div style=\"flex:1;border-left:3px solid #ff6600;padding:20px;text-align:center;\">\n      <div style=\"font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#666;margin-bottom:8px;text-align:center;\">AI Server Demand</div>\n      <div style=\"font-size:72px;font-weight:900;color:#ff6600;line-height:1;text-align:center;\">340%</div>\n      <div style=\"font-size:14px;color:#999;font-weight:600;text-align:center;\">YoY INCREASE</div>\n    </div>\n  </div>\n\n  <!-- Middle row: Copper + Timeline -->\n  <div style=\"display:flex;gap:40px;flex:1;text-align:center;\">\n\n    <!-- Copper price with SVG chart -->\n    <div style=\"flex:1;border-left:3px solid #444;padding:20px;text-align:center;\">\n      <div style=\"font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#666;margin-bottom:8px;text-align:center;\">Copper Price (LME)</div>\n      <div style=\"font-size:42px;font-weight:900;color:#ffffff;line-height:1;text-align:center;\">$13,300<span style=\"font-size:14px;color:#888;font-weight:500;\">/t</span></div>\n      <svg width=\"100%\" height=\"100\" viewBox=\"0 0 500 100\" xmlns=\"http://www.w3.org/2000/svg\" style=\"display:block;margin:10px auto 0;\">\n        <defs><linearGradient id=\"cf\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"#ff6600\" stop-opacity=\"0.25\"/><stop offset=\"100%\" stop-color=\"#ff6600\" stop-opacity=\"0\"/></linearGradient></defs>\n        <polyline points=\"10,80 46,78 82,80 118,72 154,74 190,66 226,58 262,50 298,42 334,36 370,30 406,22 442,14 478,8\" fill=\"none\" stroke=\"#ff6600\" stroke-width=\"2.5\"/>\n        <polygon points=\"10,80 46,78 82,80 118,72 154,74 190,66 226,58 262,50 298,42 334,36 370,30 406,22 442,14 478,8 478,90 10,90\" fill=\"url(#cf)\"/>\n        <text x=\"10\" y=\"98\" font-family=\"Segoe UI,Helvetica,Arial,sans-serif\" font-size=\"10\" fill=\"#555\">2024</text>\n        <text x=\"460\" y=\"98\" font-family=\"Segoe UI,Helvetica,Arial,sans-serif\" font-size=\"10\" fill=\"#ff6600\">2026</text>\n      </svg>\n    </div>\n\n    <!-- Timeline -->\n    <div style=\"flex:1.5;border-left:3px solid #ff6600;padding:20px;text-align:center;\">\n      <div style=\"font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#666;margin-bottom:12px;text-align:center;\">Order-to-Delivery Timeline</div>\n      <svg width=\"100%\" height=\"80\" viewBox=\"0 0 700 80\" xmlns=\"http://www.w3.org/2000/svg\" style=\"display:block;margin:0 auto;\">\n        <line x1=\"20\" y1=\"30\" x2=\"680\" y2=\"30\" stroke=\"#333\" stroke-width=\"2\"/>\n        <line x1=\"20\" y1=\"30\" x2=\"480\" y2=\"30\" stroke=\"#ff6600\" stroke-width=\"2\"/>\n        <circle cx=\"20\" cy=\"30\" r=\"7\" fill=\"#ff6600\"/>\n        <text x=\"20\" y=\"55\" text-anchor=\"middle\" font-family=\"Segoe UI,Helvetica,Arial,sans-serif\" font-size=\"11\" fill=\"#888\">Day 0</text>\n        <text x=\"20\" y=\"68\" text-anchor=\"middle\" font-family=\"Segoe UI,Helvetica,Arial,sans-serif\" font-size=\"10\" fill=\"#555\">Order</text>\n        <circle cx=\"106\" cy=\"30\" r=\"7\" fill=\"#ff6600\"/>\n        <text x=\"106\" y=\"55\" text-anchor=\"middle\" font-family=\"Segoe UI,Helvetica,Arial,sans-serif\" font-size=\"11\" fill=\"#ff6600\" font-weight=\"700\">Day 18</text>\n        <text x=\"106\" y=\"68\" text-anchor=\"middle\" font-family=\"Segoe UI,Helvetica,Arial,sans-serif\" font-size=\"10\" fill=\"#888\">FR-4</text>\n        <circle cx=\"350\" cy=\"30\" r=\"5\" fill=\"#444\"/>\n        <text x=\"350\" y=\"55\" text-anchor=\"middle\" font-family=\"Segoe UI,Helvetica,Arial,sans-serif\" font-size=\"11\" fill=\"#666\">Day 70</text>\n        <circle cx=\"680\" cy=\"30\" r=\"8\" fill=\"#ff3300\"/>\n        <text x=\"680\" y=\"55\" text-anchor=\"middle\" font-family=\"Segoe UI,Helvetica,Arial,sans-serif\" font-size=\"11\" fill=\"#ff3300\" font-weight=\"700\">Day 140</text>\n        <text x=\"680\" y=\"68\" text-anchor=\"middle\" font-family=\"Segoe UI,Helvetica,Arial,sans-serif\" font-size=\"10\" fill=\"#ff6600\">High-Tg</text>\n      </svg>\n\n      <!-- Impact icons row -->\n      <div style=\"display:flex;gap:24px;margin-top:16px;text-align:center;justify-content:center;\">\n        <div style=\"text-align:center;\">\n          <svg width=\"36\" height=\"36\" viewBox=\"0 0 36 36\" xmlns=\"http://www.w3.org/2000/svg\" style=\"display:block;margin:0 auto 6px;\">\n            <circle cx=\"18\" cy=\"18\" r=\"16\" fill=\"none\" stroke=\"#ff6600\" stroke-width=\"1.5\"/>\n            <text x=\"18\" y=\"24\" text-anchor=\"middle\" font-family=\"Segoe UI,Helvetica,Arial,sans-serif\" font-size=\"20\" font-weight=\"900\" fill=\"#ff6600\">!</text>\n          </svg>\n          <div style=\"font-size:12px;color:#ccc;text-align:center;\">Materials rationed</div>\n        </div>\n        <div style=\"text-align:center;\">\n          <svg width=\"36\" height=\"36\" viewBox=\"0 0 36 36\" xmlns=\"http://www.w3.org/2000/svg\" style=\"display:block;margin:0 auto 6px;\">\n            <circle cx=\"18\" cy=\"18\" r=\"16\" fill=\"none\" stroke=\"#ff6600\" stroke-width=\"1.5\"/>\n            <text x=\"18\" y=\"24\" text-anchor=\"middle\" font-family=\"Segoe UI,Helvetica,Arial,sans-serif\" font-size=\"20\" font-weight=\"900\" fill=\"#ff6600\">!</text>\n          </svg>\n          <div style=\"font-size:12px;color:#ccc;text-align:center;\">3-5 month delays</div>\n        </div>\n        <div style=\"text-align:center;\">\n          <svg width=\"36\" height=\"36\" viewBox=\"0 0 36 36\" xmlns=\"http://www.w3.org/2000/svg\" style=\"display:block;margin:0 auto 6px;\">\n            <circle cx=\"18\" cy=\"18\" r=\"16\" fill=\"none\" stroke=\"#ff6600\" stroke-width=\"1.5\"/>\n            <text x=\"18\" y=\"24\" text-anchor=\"middle\" font-family=\"Segoe UI,Helvetica,Arial,sans-serif\" font-size=\"20\" font-weight=\"900\" fill=\"#ff6600\">!</text>\n          </svg>\n          <div style=\"font-size:12px;color:#ccc;text-align:center;\">Copper squeeze</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Footer -->\n  <div style=\"display:flex;justify-content:center;align-items:center;margin-top:20px;padding-top:12px;border-top:1px solid #1a1a1a;text-align:center;\">\n    <div style=\"font-size:11px;color:#444;text-align:center;\">ILFA GmbH | Q1 2026 PCB Supply Chain Report</div>\n  </div>\n\n</div>\n</body>\n</html>",
  "account": "company",
  "headline": "PCB Lead Times Hit 140 Days as AI Demand Strains Supply",
  "caption": "PCB supply chain report.\nSources:\nILFA GmbH \u2014 https://ilfa.de"
