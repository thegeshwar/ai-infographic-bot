  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=1920, height=1080\">\n<title>OpenAI Secures Record $40B Funding</title>\n</head>\n<body style=\"margin:0;padding:0;width:1920px;height:1080px;background:#0d1117;font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#e6edf3;overflow:hidden;position:relative;\">\n\n<!-- Subtle grid background -->\n<div style=\"position:absolute;top:0;left:0;width:100%;height:100%;background-image:radial-gradient(circle at 1px 1px, rgba(79,140,255,0.06) 1px, transparent 0);background-size:40px 40px;z-index:0;\"></div>\n\n<!-- Top accent line -->\n<div style=\"position:absolute;top:0;left:0;width:100%;height:4px;background:linear-gradient(90deg,transparent,#4f8cff,transparent);z-index:2;\"></div>\n\n<!-- Glow effects -->\n<div style=\"position:absolute;top:-200px;left:50%;transform:translateX(-50%);width:800px;height:600px;background:radial-gradient(ellipse,rgba(79,140,255,0.08),transparent 70%);z-index:0;\"></div>\n<div style=\"position:absolute;bottom:-100px;right:100px;width:500px;height:400px;background:radial-gradient(ellipse,rgba(79,140,255,0.05),transparent 70%);z-index:0;\"></div>\n\n<!-- Main content wrapper -->\n<div style=\"position:relative;z-index:1;width:100%;height:100%;display:flex;flex-direction:column;padding:60px 80px;box-sizing:border-box;\">\n\n  <!-- Header -->\n  <div style=\"display:flex;align-items:center;gap:20px;margin-bottom:8px;\">\n    <div style=\"width:6px;height:48px;background:#4f8cff;border-radius:3px;\"></div>\n    <div style=\"font-size:14px;font-weight:600;text-transform:uppercase;letter-spacing:4px;color:#4f8cff;\">Breaking News &mdash; Funding Round</div>\n  </div>\n\n  <!-- Title -->\n  <div style=\"margin-left:26px;margin-bottom:40px;\">\n    <h1 style=\"margin:0;font-size:52px;font-weight:800;line-height:1.15;color:#ffffff;max-width:1200px;\">\n      OpenAI Secures Record <span style=\"color:#4f8cff;\">$40 Billion</span> Funding<br>at <span style=\"color:#4f8cff;\">$300 Billion</span> Valuation\n    </h1>\n    <p style=\"margin:12px 0 0 0;font-size:18px;color:#8b949e;font-weight:400;\">The largest private funding round in history.</p>\n    <!-- Upward trend arrow SVG -->\n    <svg width=\"60\" height=\"32\" viewBox=\"0 0 60 32\" style=\"margin-top:8px;\"><polyline points=\"2,28 15,22 28,18 40,10 52,4\" fill=\"none\" stroke=\"#4f8cff\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><polygon points=\"48,2 58,4 52,12\" fill=\"#4f8cff\"/></svg>\n  </div>\n\n  <!-- Stats row -->\n  <div style=\"display:flex;gap:32px;margin-left:26px;margin-bottom:48px;\">\n\n    <!-- Stat card 1 -->\n    <div style=\"flex:1;background:linear-gradient(135deg,rgba(79,140,255,0.12),rgba(79,140,255,0.04));border:1px solid rgba(79,140,255,0.2);padding:32px 28px;text-align:center;position:relative;overflow:hidden;\">\n      <div style=\"position:absolute;top:0;left:0;width:100%;height:3px;background:linear-gradient(90deg,#4f8cff,transparent);\"></div>\n      <div style=\"font-size:56px;font-weight:900;color:#4f8cff;line-height:1;margin-bottom:8px;\">$40B</div>\n      <div style=\"font-size:15px;color:#8b949e;text-transform:uppercase;letter-spacing:2px;font-weight:600;\">Total Raised</div>\n    </div>\n\n    <!-- Stat card 2 -->\n    <div style=\"flex:1;background:linear-gradient(135deg,rgba(79,140,255,0.12),rgba(79,140,255,0.04));border:1px solid rgba(79,140,255,0.2);padding:32px 28px;text-align:center;position:relative;overflow:hidden;\">\n      <div style=\"position:absolute;top:0;left:0;width:100%;height:3px;background:linear-gradient(90deg,#4f8cff,transparent);\"></div>\n      <div style=\"font-size:56px;font-weight:900;color:#ffffff;line-height:1;margin-bottom:8px;\">$300B</div>\n      <div style=\"font-size:15px;color:#8b949e;text-transform:uppercase;letter-spacing:2px;font-weight:600;\">Valuation</div>\n    </div>\n\n    <!-- Stat card 3 -->\n    <div style=\"flex:1;background:linear-gradient(135deg,rgba(79,140,255,0.12),rgba(79,140,255,0.04));border:1px solid rgba(79,140,255,0.2);padding:32px 28px;text-align:center;position:relative;overflow:hidden;\">\n      <div style=\"position:absolute;top:0;left:0;width:100%;height:3px;background:linear-gradient(90deg,#4f8cff,transparent);\"></div>\n      <div style=\"font-size:56px;font-weight:900;color:#ffffff;line-height:1;margin-bottom:8px;\">$13B</div>\n      <div style=\"font-size:15px;color:#8b949e;text-transform:uppercase;letter-spacing:2px;font-weight:600;\">Annual Revenue</div>\n    </div>\n\n    <!-- Stat card 4 -->\n    <div style=\"flex:1;background:linear-gradient(135deg,rgba(79,140,255,0.12),rgba(79,140,255,0.04));border:1px solid rgba(79,140,255,0.2);padding:32px 28px;text-align:center;position:relative;overflow:hidden;\">\n      <div style=\"position:absolute;top:0;left:0;width:100%;height:3px;background:linear-gradient(90deg,#4f8cff,transparent);\"></div>\n      <div style=\"font-size:56px;font-weight:900;color:#ffffff;line-height:1;margin-bottom:8px;\">400M</div>\n      <div style=\"font-size:15px;color:#8b949e;text-transform:uppercase;letter-spacing:2px;font-weight:600;\">Weekly Active Users</div>\n    </div>\n\n  </div>\n\n  <!-- Bottom section: Context + Record badge -->\n  <div style=\"display:flex;gap:40px;margin-left:26px;flex:1;align-items:stretch;\">\n\n    <!-- Key details column -->\n    <div style=\"flex:2;display:flex;flex-direction:column;gap:20px;\">\n\n      <div style=\"display:flex;align-items:flex-start;gap:16px;background:rgba(255,255,255,0.03);padding:20px 24px;border-left:3px solid #4f8cff;\">\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4f8cff\" stroke-width=\"2\" style=\"min-width:20px;margin-top:2px;\"><path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\"/></svg>\n        <div>\n          <div style=\"font-size:16px;font-weight:700;color:#e6edf3;margin-bottom:4px;\">Biggest Private Round Ever</div>\n          <div style=\"font-size:14px;color:#8b949e;line-height:1.5;\">SoftBank leads record-shattering round.</div>\n        </div>\n      </div>\n\n      <div style=\"display:flex;align-items:flex-start;gap:16px;background:rgba(255,255,255,0.03);padding:20px 24px;border-left:3px solid rgba(79,140,255,0.4);\">\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4f8cff\" stroke-width=\"2\" style=\"min-width:20px;margin-top:2px;\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/></svg>\n        <div>\n          <div style=\"font-size:16px;font-weight:700;color:#e6edf3;margin-bottom:4px;\">Explosive Growth</div>\n          <div style=\"font-size:14px;color:#8b949e;line-height:1.5;\">400M weekly users, $13B annualized revenue.</div>\n        </div>\n      </div>\n\n      <div style=\"display:flex;align-items:flex-start;gap:16px;background:rgba(255,255,255,0.03);padding:20px 24px;border-left:3px solid rgba(79,140,255,0.25);\">\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4f8cff\" stroke-width=\"2\" style=\"min-width:20px;margin-top:2px;\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>\n        <div>\n          <div style=\"font-size:16px;font-weight:700;color:#e6edf3;margin-bottom:4px;\">For-Profit Transition</div>\n          <div style=\"font-size:14px;color:#8b949e;line-height:1.5;\">Restructuring from capped-profit to full for-profit.</div>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- Record badge / visual highlight -->\n    <div style=\"flex:1;display:flex;align-items:center;justify-content:center;\">\n      <div style=\"text-align:center;position:relative;\">\n        <!-- Outer ring -->\n        <div style=\"width:280px;height:280px;border-radius:50%;border:2px solid rgba(79,140,255,0.3);display:flex;align-items:center;justify-content:center;position:relative;background:radial-gradient(circle,rgba(79,140,255,0.08),transparent 70%);\">\n          <!-- Inner ring -->\n          <div style=\"width:230px;height:230px;border-radius:50%;border:1px solid rgba(79,140,255,0.15);display:flex;flex-direction:column;align-items:center;justify-content:center;\">\n            <div style=\"font-size:13px;text-transform:uppercase;letter-spacing:3px;color:#4f8cff;font-weight:700;margin-bottom:8px;\">Record</div>\n            <div style=\"font-size:72px;font-weight:900;color:#4f8cff;line-height:1;\">$40B</div>\n            <div style=\"font-size:14px;color:#8b949e;margin-top:8px;letter-spacing:1px;\">LARGEST PRIVATE</div>\n            <div style=\"font-size:14px;color:#8b949e;letter-spacing:1px;\">FUNDING ROUND</div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n  </div>\n\n  <!-- Footer -->\n  <div style=\"display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:24px;border-top:1px solid rgba(79,140,255,0.1);margin-left:26px;\">\n    <div style=\"font-size:12px;color:#484f58;\">Source: TechCrunch</div>\n    <div style=\"font-size:12px;color:#484f58;\">thegeshwar &bull; AI News Infographic</div>\n  </div>\n\n</div>\n\n</body>\n</html>",
  "account": "personal",
  "headline": "OpenAI Secures Record $40B Funding at $300B Valuation",
  "caption": "OpenAI funding round.\nSources:\nTechCrunch \u2014 https://techcrunch.com"
