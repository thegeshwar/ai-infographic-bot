{
  "headline": "OpenAI Secures Record $40B Funding at $300B Valuation",
  "account": "personal",
  "caption": "OpenAI just closed the biggest private funding round in history.\n$40 billion raised at a $300 billion valuation.\nThat makes OpenAI the most valuable private company on the planet.\nWith 400 million weekly active users and $13 billion in annual revenue, the numbers speak for themselves.\nThis is not just a funding round. It is a signal of where capital sees the future going.\nSources:\nTechCrunch \u2014 https://techcrunch.com",
  "html": "<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\"></head>\n<body style=\"margin:0;padding:0;background:#0a0e1a;\">\n<div style=\"width:1920px;height:1080px;position:relative;overflow:hidden;background:#0a0e1a;font-family:system-ui,-apple-system,BlinkMacSystemFont,sans-serif;color:#ffffff;box-sizing:border-box;\">\n\n<!-- Background SVG pattern: money/funding themed icons -->\n<svg style=\"position:absolute;top:0;left:0;width:1920px;height:1080px;opacity:0.07;\" xmlns=\"http://www.w3.org/2000/svg\">\n<defs>\n<pattern id=\"bgpat\" x=\"0\" y=\"0\" width=\"80\" height=\"80\" patternUnits=\"userSpaceOnUse\">\n<!-- Dollar sign -->\n<text x=\"10\" y=\"28\" font-size=\"20\" fill=\"#4f8cff\" font-family=\"system-ui\" font-weight=\"700\">$</text>\n<!-- Up arrow -->\n<path d=\"M55 25 L60 15 L65 25 M60 15 L60 35\" stroke=\"#4f8cff\" stroke-width=\"1.5\" fill=\"none\"/>\n<!-- Small chart bars -->\n<rect x=\"10\" y=\"50\" width=\"6\" height=\"18\" fill=\"#4f8cff\" rx=\"1\"/>\n<rect x=\"20\" y=\"55\" width=\"6\" height=\"13\" fill=\"#4f8cff\" rx=\"1\"/>\n<rect x=\"30\" y=\"45\" width=\"6\" height=\"23\" fill=\"#4f8cff\" rx=\"1\"/>\n<!-- Circle coin -->\n<circle cx=\"60\" cy=\"62\" r=\"8\" stroke=\"#4f8cff\" stroke-width=\"1.5\" fill=\"none\"/>\n</pattern>\n</defs>\n<rect width=\"1920\" height=\"1080\" fill=\"url(#bgpat)\"/>\n</svg>\n\n<!-- Radial gradient orb behind left content -->\n<div style=\"position:absolute;top:200px;left:200px;width:700px;height:700px;border-radius:50%;background:radial-gradient(circle,rgba(79,140,255,0.10) 0%,transparent 70%);pointer-events:none;\"></div>\n\n<!-- Radial gradient orb behind right content -->\n<div style=\"position:absolute;top:400px;right:100px;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(79,140,255,0.06) 0%,transparent 70%);pointer-events:none;\"></div>\n\n<!-- Main layout: two columns -->\n<div style=\"position:absolute;top:0;left:0;width:1920px;height:1080px;display:flex;flex-direction:row;align-items:center;box-sizing:border-box;padding:60px 80px;\">\n\n<!-- LEFT COLUMN (55%) -->\n<div style=\"width:55%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding-right:60px;box-sizing:border-box;\">\n\n<!-- Hook label -->\n<div style=\"font-size:16px;font-weight:400;text-transform:uppercase;letter-spacing:3px;color:rgba(79,140,255,0.8);margin-bottom:32px;text-align:center;\">Biggest Private Funding Round in History</div>\n\n<!-- OpenAI SVG logo mark -->\n<svg width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" style=\"margin-bottom:28px;\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M24 4 L34 9 L40 19 L40 29 L34 39 L24 44 L14 39 L8 29 L8 19 L14 9 Z\" stroke=\"#4f8cff\" stroke-width=\"2\" fill=\"none\"/>\n<path d=\"M24 12 L30 15 L33 21 L33 27 L30 33 L24 36 L18 33 L15 27 L15 21 L18 15 Z\" stroke=\"#4f8cff\" stroke-width=\"1.5\" fill=\"none\"/>\n<circle cx=\"24\" cy=\"24\" r=\"4\" fill=\"#4f8cff\" opacity=\"0.6\"/>\n</svg>\n\n<!-- Hero number -->\n<div style=\"font-size:110px;font-weight:900;letter-spacing:-3px;line-height:1;color:#ffffff;text-align:center;margin-bottom:16px;\">$40B</div>\n\n<!-- Headline -->\n<div style=\"font-size:32px;font-weight:700;line-height:1.3;color:#ffffff;text-align:center;margin-bottom:24px;max-width:600px;\">OpenAI Secures Record Funding<br>at $300B Valuation</div>\n\n<!-- Context body text -->\n<div style=\"font-size:21px;font-weight:300;line-height:1.6;color:rgba(255,255,255,0.75);text-align:center;max-width:560px;margin-bottom:40px;\">The largest private funding round ever closed positions OpenAI as the most valuable private company globally, surpassing SpaceX and Stripe by a wide margin.</div>\n\n<!-- Accent line -->\n<div style=\"width:80px;height:4px;background:#4f8cff;border-radius:2px;margin-bottom:40px;\"></div>\n\n<!-- Valuation callout with left accent border -->\n<div style=\"border-left:4px solid #4f8cff;padding-left:24px;text-align:center;max-width:480px;\">\n<div style=\"font-size:48px;font-weight:900;color:#4f8cff;text-align:center;\">$300B</div>\n<div style=\"font-size:17px;font-weight:400;text-transform:uppercase;letter-spacing:2px;color:rgba(255,255,255,0.55);text-align:center;margin-top:6px;\">Post Money Valuation</div>\n</div>\n\n</div>\n\n<!-- Vertical divider -->\n<div style=\"width:1px;height:700px;background:linear-gradient(to bottom,transparent,rgba(79,140,255,0.3),rgba(79,140,255,0.3),transparent);flex-shrink:0;\"></div>\n\n<!-- RIGHT COLUMN (45%) -->\n<div style=\"width:45%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding-left:60px;box-sizing:border-box;\">\n\n<!-- Section header -->\n<div style=\"font-size:18px;font-weight:400;text-transform:uppercase;letter-spacing:3px;color:rgba(79,140,255,0.7);margin-bottom:48px;text-align:center;\">Key Numbers</div>\n\n<!-- Stat: Annual Revenue -->\n<div style=\"margin-bottom:44px;text-align:center;\">\n<div style=\"font-size:52px;font-weight:900;color:#ffffff;text-align:center;\">$13B</div>\n<div style=\"font-size:17px;font-weight:400;text-transform:uppercase;letter-spacing:2px;color:rgba(255,255,255,0.5);margin-top:6px;text-align:center;\">Annual Revenue Run Rate</div>\n</div>\n\n<!-- Stat: Weekly Active Users -->\n<div style=\"margin-bottom:52px;text-align:center;\">\n<div style=\"font-size:52px;font-weight:900;color:#ffffff;text-align:center;\">400M</div>\n<div style=\"font-size:17px;font-weight:400;text-transform:uppercase;letter-spacing:2px;color:rgba(255,255,255,0.5);margin-top:6px;text-align:center;\">Weekly Active Users</div>\n</div>\n\n<!-- SVG Bar Chart: Funding comparison -->\n<div style=\"text-align:center;margin-bottom:16px;\">\n<div style=\"font-size:16px;font-weight:400;text-transform:uppercase;letter-spacing:2px;color:rgba(255,255,255,0.45);margin-bottom:20px;text-align:center;\">Largest Private Rounds (Billions)</div>\n<svg width=\"480\" height=\"200\" viewBox=\"0 0 480 200\" xmlns=\"http://www.w3.org/2000/svg\">\n<!-- Y axis line -->\n<line x1=\"70\" y1=\"10\" x2=\"70\" y2=\"170\" stroke=\"rgba(255,255,255,0.15)\" stroke-width=\"1\"/>\n<!-- Horizontal grid lines -->\n<line x1=\"70\" y1=\"10\" x2=\"460\" y2=\"10\" stroke=\"rgba(255,255,255,0.06)\" stroke-width=\"1\"/>\n<line x1=\"70\" y1=\"50\" x2=\"460\" y2=\"50\" stroke=\"rgba(255,255,255,0.06)\" stroke-width=\"1\"/>\n<line x1=\"70\" y1=\"90\" x2=\"460\" y2=\"90\" stroke=\"rgba(255,255,255,0.06)\" stroke-width=\"1\"/>\n<line x1=\"70\" y1=\"130\" x2=\"460\" y2=\"130\" stroke=\"rgba(255,255,255,0.06)\" stroke-width=\"1\"/>\n\n<!-- Bar: OpenAI $40B (full width) -->\n<rect x=\"72\" y=\"18\" width=\"380\" height=\"30\" fill=\"#4f8cff\" rx=\"2\"/>\n<text x=\"80\" y=\"38\" font-size=\"15\" fill=\"#ffffff\" font-weight=\"700\" font-family=\"system-ui\">OpenAI</text>\n<text x=\"420\" y=\"38\" font-size=\"14\" fill=\"#ffffff\" font-weight=\"400\" font-family=\"system-ui\" text-anchor=\"end\">$40B</text>\n\n<!-- Bar: Jio Platforms $20B -->\n<rect x=\"72\" y=\"58\" width=\"190\" height=\"30\" fill=\"rgba(79,140,255,0.45)\" rx=\"2\"/>\n<text x=\"80\" y=\"78\" font-size=\"15\" fill=\"#ffffff\" font-weight=\"600\" font-family=\"system-ui\">Jio Platforms</text>\n<text x=\"254\" y=\"78\" font-size=\"14\" fill=\"rgba(255,255,255,0.7)\" font-weight=\"400\" font-family=\"system-ui\">$20B</text>\n\n<!-- Bar: SpaceX $13B -->\n<rect x=\"72\" y=\"98\" width=\"124\" height=\"30\" fill=\"rgba(79,140,255,0.3)\" rx=\"2\"/>\n<text x=\"80\" y=\"118\" font-size=\"15\" fill=\"#ffffff\" font-weight=\"600\" font-family=\"system-ui\">SpaceX</text>\n<text x=\"188\" y=\"118\" font-size=\"14\" fill=\"rgba(255,255,255,0.7)\" font-weight=\"400\" font-family=\"system-ui\">$13B</text>\n\n<!-- Bar: Stripe $6.5B -->\n<rect x=\"72\" y=\"138\" width=\"62\" height=\"30\" fill=\"rgba(79,140,255,0.2)\" rx=\"2\"/>\n<text x=\"80\" y=\"158\" font-size=\"15\" fill=\"#ffffff\" font-weight=\"600\" font-family=\"system-ui\">Stripe</text>\n<text x=\"140\" y=\"158\" font-size=\"14\" fill=\"rgba(255,255,255,0.7)\" font-weight=\"400\" font-family=\"system-ui\">$6.5B</text>\n\n<!-- Axis labels -->\n<text x=\"460\" y=\"185\" font-size=\"13\" fill=\"rgba(255,255,255,0.35)\" font-family=\"system-ui\" text-anchor=\"end\">Source: TechCrunch</text>\n</svg>\n</div>\n\n</div>\n\n</div>\n\n<!-- Footer -->\n<div style=\"position:absolute;bottom:0;left:0;width:1920px;box-sizing:border-box;padding:0 80px 20px 80px;\">\n<div style=\"border-top:1px solid rgba(255,255,255,0.1);padding-top:12px;display:flex;justify-content:space-between;align-items:center;\">\n<div style=\"font-size:13px;color:rgba(255,255,255,0.35);text-align:center;\">TechCrunch</div>\n<div style=\"font-size:13px;color:rgba(255,255,255,0.35);text-align:center;\">thegeshwar</div>\n</div>\n</div>\n\n</div>\n</body>\n</html>"
}