stop offset=\"100%\" stop-color=\"#cd7f32\" stop-opacity=\"0\"/>\n</radialGradient>\n</defs>\n<rect width=\"1920\" height=\"1080\" fill=\"url(#chipPattern)\"/>\n<rect width=\"1920\" height=\"1080\" fill=\"url(#orbLeft)\"/>\n<rect width=\"1920\" height=\"1080\" fill=\"url(#orbRight)\"/>\n</svg>\n\n<!-- HEADER ZONE -->\n<div style=\"height:100px;flex-shrink:0;display:flex;flex-direction:row;align-items:center;justify-content:space-between;padding:0 60px;position:relative;z-index:1;\">\n<div style=\"display:flex;align-items:center;gap:16px;\">\n<img alt=\"Cu Circuits\" src=\"\" style=\"height:72px;width:auto;\" />\n</div>\n<div style=\"display:flex;align-items:center;gap:8px;\">\n<span style=\"font-size:16px;font-weight:300;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,0.5);\">INDIA SEMICONDUCTOR REPORT</span>\n<span style=\"font-size:16px;color:rgba(255,255,255,0.3);\">|</span>\n<span style=\"font-size:16px;font-weight:300;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.4);\">2026</span>\n</div>\n</div>\n\n<!-- CONTENT ZONE -->\n<div style=\"flex:1;display:flex;overflow:hidden;padding:0 60px;gap:60px;position:relative;z-index:1;\">\n\n<!-- LEFT COLUMN (50%) -->\n<div style=\"flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;gap:24px;\">\n\n<!-- Hero number -->\n<div style=\"text-align:center;\">\n<div style=\"font-size:110px;font-weight:900;color:#cd7f32;letter-spacing:-3px;line-height:1;\">80M</div>\n<div style=\"font-size:22px;font-weight:300;color:rgba(255,255,255,0.7);letter-spacing:2px;text-transform:uppercase;margin-top:8px;\">CHIPS PER DAY</div>\n</div>\n\n<!-- Headline -->\n<div style=\"text-align:center;max-width:700px;\">\n<div style=\"font-size:32px;font-weight:700;color:#fff;line-height:1.3;\">India's Semiconductor</div>\n<div style=\"font-size:32px;font-weight:700;color:#fff;line-height:1.3;\">Production Target by Late 2026</div>\n</div>\n\n<!-- Investment stat -->\n<div style=\"text-align:center;margin-top:12px;\">\n<div style=\"width:80px;height:3px;background:#cd7f32;margin:0 auto 16px;border-radius:1px;\"></div>\n<div style=\"font-size:56px;font-weight:900;color:#fff;\">$15.2B</div>\n<div style=\"font-size:18px;font-weight:300;color:rgba(255,255,255,0.6);letter-spacing:2px;text-transform:uppercase;margin-top:4px;\">TOTAL INVESTMENT</div>\n</div>\n\n<!-- Jobs stat -->\n<div style=\"text-align:center;\">\n<div style=\"font-size:48px;font-weight:900;color:#cd7f32;\">28,000</div>\n<div style=\"font-size:18px;font-weight:300;color:rgba(255,255,255,0.6);letter-spacing:2px;text-transform:uppercase;margin-top:4px;\">DIRECT JOBS CREATED</div>\n</div>\n\n</div>\n\n<!-- Vertical divider -->\n<div style=\"width:2px;background:linear-gradient(to bottom,transparent,rgba(205,127,50,0.3),transparent);flex-shrink:0;\"></div>\n\n<!-- RIGHT COLUMN (50%) -->\n<div style=\"flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;gap:32px;\">\n\n<!-- Section label -->\n<div style=\"text-align:center;\">\n<div style=\"font-size:18px;font-weight:300;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,0.5);\">4 PLANTS GOING COMMERCIAL</div>\n</div>\n\n<!-- Plant cards as horizontal bar chart -->\n<div style=\"width:100%;max-width:700px;display:flex;flex-direction:column;gap:20px;\">\n\n<!-- Tata Electronics -->\n<div style=\"text-align:center;\">\n<div style=\"font-size:22px;font-weight:700;color:#fff;margin-bottom:6px;\">Tata Electronics, Assam</div>\n<svg width=\"600\" height=\"28\" viewBox=\"0 0 600 28\" style=\"display:block;margin:0 auto;\">\n<rect x=\"0\" y=\"4\" width=\"600\" height=\"20\" rx=\"2\" fill=\"rgba(205,127,50,0.12)\"/>\n<rect x=\"0\" y=\"4\" width=\"480\" height=\"20\" rx=\"2\" fill=\"#cd7f32\"/>\n<text x=\"490\" y=\"19\" fill=\"rgba(255,255,255,0.7)\" font-size=\"16\" font-family=\"system-ui\">Assembly &amp; Test</text>\n</svg>\n</div>\n\n<!-- Micron Gujarat -->\n<div style=\"text-align:center;\">\n<div style=\"font-size:22px;font-weight:700;color:#fff;margin-bottom:6px;\">Micron, Gujarat</div>\n<svg width=\"600\" height=\"28\" viewBox=\"0 0 600 28\" style=\"display:block;margin:0 auto;\">\n<rect x=\"0\" y=\"4\" width=\"600\" height=\"20\" rx=\"2\" fill=\"rgba(205,127,50,0.12)\"/>\n<rect x=\"0\" y=\"4\" width=\"420\" height=\"20\" rx=\"2\" fill=\"rgba(205,127,50,0.8)\"/>\n<text x=\"430\" y=\"19\" fill=\"rgba(255,255,255,0.7)\" font-size=\"16\" font-family=\"system-ui\">Memory Packaging</text>\n</svg>\n</div>\n\n<!-- CG Power -->\n<div style=\"text-align:center;\">\n<div style=\"font-size:22px;font-weight:700;color:#fff;margin-bottom:6px;\">CG Power</div>\n<svg width=\"600\" height=\"28\" viewBox=\"0 0 600 28\" style=\"display:block;margin:0 auto;\">\n<rect x=\"0\" y=\"4\" width=\"600\" height=\"20\" rx=\"2\" fill=\"rgba(205,127,50,0.12)\"/>\n<rect x=\"0\" y=\"4\" width=\"360\" height=\"20\" rx=\"2\" fill=\"rgba(205,127,50,0.6)\"/>\n<text x=\"370\" y=\"19\" fill=\"rgba(255,255,255,0.7)\" font-size=\"16\" font-family=\"system-ui\">OSAT Facility</text>\n</svg>\n</div>\n\n<!-- RRP Electronics -->\n<div style=\"text-align:center;\">\n<div style=\"font-size:22px;font-weight:700;color:#fff;margin-bottom:6px;\">RRP Electronics</div>\n<svg width=\"600\" height=\"28\" viewBox=\"0 0 600 28\" style=\"display:block;margin:0 auto;\">\n<rect x=\"0\" y=\"4\" width=\"600\" height=\"20\" rx=\"2\" fill=\"rgba(205,127,50,0.12)\"/>\n<rect x=\"0\" y=\"4\" width=\"300\" height=\"20\" rx=\"2\" fill=\"rgba(205,127,50,0.45)\"/>\n<text x=\"310\" y=\"19\" fill=\"rgba(255,255,255,0.7)\" font-size=\"16\" font-family=\"system-ui\">Compound Semiconductors</text>\n</svg>\n</div>\n\n</div>\n\n<!-- Insight -->\n<div style=\"text-align:center;max-width:600px;border-left:4px solid #cd7f32;padding-left:24px;\">\n<div style=\"font-size:20px;font-weight:300;color:rgba(255,255,255,0.8);line-height:1.6;\">India moves from zero chip production to 80 million units daily in under three years, backed by $15.2B in committed capital across four facilities.</div>\n</div>\n\n</div>\n\n</div>\n\n<!-- FOOTER ZONE -->\n<div style=\"height:60px;flex-shrink:0;position:relative;z-index:1;\">\n<div style=\"height:1px;background:rgba(205,127,50,0.2);margin:0 60px;\"></div>\n<div style=\"display:flex;flex-direction:row;align-items:center;justify-content:space-between;padding:12px 60px 0;\">\n<div style=\"font-size:13px;color:rgba(255,255,255,0.4);\">cucircuits.com</div>\n<div style=\"font-size:13px;color:rgba(255,255,255,0.35);text-align:right;\">Source: India Semiconductor Mission, Reuters</div>\n</div>\n</div>\n\n</div>\n</body>\n</html>"
